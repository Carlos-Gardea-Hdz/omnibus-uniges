APP_NAME=UNIGES
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_VERSION=0.1.0
APP_URL=http://localhost

# Bilingual UI: Spanish-first, English fallback (project law).
APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_MX

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ── PostgreSQL 18 (never MySQL/SQLite in production) ───────────────────────
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=uniges
DB_USERNAME=uniges
DB_PASSWORD=

# ── Sessions / cache / queues on Valkey 8.0 (Redis protocol) ───────────────
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Production: serve over HTTPS only.
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=valkey
REDIS_PASSWORD=null
REDIS_PORT=6379

# ── Broadcasting: Laravel Reverb (self-hosted WebSockets) ──────────────────
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# ── Mail (SendGrid via Laravel Mail in production) ─────────────────────────
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@titulacion.carlosgardea.com"
MAIL_FROM_NAME="${APP_NAME}"

# ── Inertia SSR (build with `pnpm build:ssr`) ──────────────────────────────
INERTIA_SSR_ENABLED=false

VITE_APP_NAME="${APP_NAME}"
